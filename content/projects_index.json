      "CAD Modeling",
      "Mechanical Design",
      "Rapid Prototyping",
      "Assistive Design",
      "Physical Prototyping",
      "Design for Accessibility"
    ],
    "decision": {
      "question": "Should the cup sit on top of the leveling ring, or hang below it?",
      "rejected": {
        "option": "Cup seated on top of the gimbal ring",
        "why": "Puts the mass above the pivot, so the whole assembly wobbles and the cup can slide out under sudden motion"
      },
      "chosen": {
        "option": "Cup suspended below the rotation center, with the base doubling as counterweight",
        "why": "Gravity does the correcting work: a low center of mass returns the cup to level on its own, and the vertical frame supports the cup along its full height"
      },
      "quote": "The stabilization is not controlled — it is designed into the geometry."
    },
